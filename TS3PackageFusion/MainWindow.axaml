<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TS3PackageFusion.MainWindow" Title="TS3 Package Fusion - Gestionnaire de packages" Width="1040" Height="680" MinWidth="840" MinHeight="560" Background="#19244A">
  <Window.Styles>
    <Style Selector="Button.action"><Setter Property="Margin" Value="0,0,0,9"/><Setter Property="Padding" Value="12,9"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#122B5D"/><Setter Property="Background" Value="#A8D1FF"/><Setter Property="BorderBrush" Value="#E2F0FF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/></Style>
    <Style Selector="Button.action:pointerover"><Setter Property="Background" Value="#CAE4FF"/></Style>
    <Style Selector="Button.merge"><Setter Property="Background" Value="#78D9A3"/><Setter Property="BorderBrush" Value="#D5FFE6"/><Setter Property="Foreground" Value="#113D2A"/></Style>
    <Style Selector="ListBox"><Setter Property="Background" Value="#B9DAFA"/><Setter Property="BorderBrush" Value="#527FC2"/><Setter Property="BorderThickness" Value="2"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="6"/></Style>
    <Style Selector="ListBoxItem"><Setter Property="Foreground" Value="#173A76"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="8,7"/></Style>
    <Style Selector="ListBoxItem:pointerover"><Setter Property="Background" Value="#D8ECFF"/></Style>
    <Style Selector="ListBoxItem:selected"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#79A05B"/></Style>
  </Window.Styles>
  <Grid Margin="12" ColumnDefinitions="220,12,*,12,235">
    <Border Background="#8FC4FC" BorderBrush="#D6EBFF" BorderThickness="2" CornerRadius="8" Padding="12">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel HorizontalAlignment="Center" Spacing="5"><Border Width="140" Height="140" Background="#D5EBFF" BorderBrush="#4C78C1" BorderThickness="3" CornerRadius="70"><Image Source="avares://TS3PackageFusion/Assets/Sims3Plumbob.png" Stretch="Uniform" Margin="19"/></Border><TextBlock Text="TS3 Package Fusion" FontSize="18" FontWeight="Bold" Foreground="#153775" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,26,0,0"><TextBlock Text="PACKAGES" FontWeight="Bold" Foreground="#204782" Margin="4,0,0,8"/><Button Classes="action" Content="Ajouter des packages" Click="AddPackages"/><Button Classes="action" Content="Importer des Sims3Pack" Click="ImportSims3Packs"/><TextBlock Text="PROJET" FontWeight="Bold" Foreground="#204782" Margin="4,10,0,8"/><Button Classes="action" Content="Ouvrir un projet" Click="OpenProject"/></StackPanel>
        <TextBlock Grid.Row="3" Text="Documents\TS3PackageFusion" Foreground="#365B8F" FontSize="11" HorizontalAlignment="Center"/>
      </Grid>
    </Border>
    <Border Grid.Column="2" Background="#D8ECFF" BorderBrush="#91C4FA" BorderThickness="2" CornerRadius="8" Padding="12">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Border Background="#405F9F" CornerRadius="5" Padding="11"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="PACKAGES DU PROJET" Foreground="#BEE2FF" FontSize="12" FontWeight="Bold"/><TextBlock Text="Choisis les fichiers à fusionner" Foreground="White" FontSize="19" FontWeight="SemiBold"/></StackPanel><Image Grid.Column="1" Source="avares://TS3PackageFusion/Assets/Sims3Plumbob.png" Width="42" Height="42" Stretch="Uniform"/></Grid></Border>
        <Border Name="ConflictNotice" Grid.Row="1" IsVisible="False" Background="#FFF3C5" BorderBrush="#D69E23" BorderThickness="1" Padding="8" Margin="0,10,0,8" CornerRadius="4"><Button HorizontalAlignment="Left" Click="ShowInitialConflicts" Background="Transparent" BorderThickness="0" Padding="0"><TextBlock Name="ConflictNoticeText" Foreground="#735500" TextWrapping="Wrap"/></Button></Border>
        <ListBox Name="PackageList" Grid.Row="2"/>
        <StackPanel Grid.Row="3" Margin="0,10,0,0" Spacing="6">
          <StackPanel Name="MergeProgressArea" IsVisible="False" Spacing="3">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Name="MergeProgressText" Foreground="#24487A" Text="Fusion en préparation..."/><TextBlock Name="MergeProgressPercent" Grid.Column="1" Foreground="#24487A" FontWeight="SemiBold"/></Grid>
            <ProgressBar Name="MergeProgressBar" Minimum="0" Maximum="100" Height="10"/>
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto"><TextBlock Name="Status" Foreground="#24487A" VerticalAlignment="Center" TextWrapping="Wrap"/><Button Grid.Column="1" Classes="action" Margin="8,0,0,0" Padding="12,7" Content="Retirer la sélection" Click="RemoveSelected"/></Grid>
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Column="4" Background="#8FC4FC" BorderBrush="#D6EBFF" BorderThickness="2" CornerRadius="8" Padding="12">
      <Grid RowDefinitions="Auto,Auto,*,Auto"><TextBlock Text="ACTIONS" Foreground="#153775" FontWeight="Bold" HorizontalAlignment="Center"/><Border Grid.Row="1" Margin="0,12,0,0" Background="#D5EBFF" BorderBrush="#4C78C1" BorderThickness="1" CornerRadius="5" Padding="10"><StackPanel Spacing="5"><TextBlock Text="1. Ajoute tes packages" Foreground="#234D89"/><TextBlock Text="2. Vérifie les conflits" Foreground="#234D89"/><TextBlock Text="3. Lance la fusion" Foreground="#234D89"/></StackPanel></Border><StackPanel Grid.Row="2" VerticalAlignment="Bottom"><Button Classes="action" Content="Enregistrer le projet" Click="SaveProject"/><Button Classes="action merge" Content="Fusionner et enregistrer" Click="MergePackages"/></StackPanel><TextBlock Grid.Row="3" Text="Les fichiers originaux ne sont jamais modifiés." Foreground="#365B8F" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/></Grid>
    </Border>
  </Grid>
</Window>
